!tools/extract/genres.tsv
!tools/extract/assign.tsv
!tools/extract/attrib.tsv
!tools/extract/moods.tsv
!tools/extract/mood.tsv
!tools/extract/dirs.tsv
node_modules/
.DS_Store
Thumbs.db
